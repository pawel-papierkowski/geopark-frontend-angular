{
  "name": "geopark-frontend-angular",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/generate-i18n-manifest.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/generate-i18n-manifest.mjs",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:ng": "ng test",
    "e2e": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "e2e:report": "npx playwright show-report",
    "pretypecheck": "node scripts/generate-i18n-manifest.mjs",
    "typecheck": "npm run typecheck:app && npm run typecheck:spec && npm run typecheck:e2e",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.playwright.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@analogjs/vitest-angular": "^2.7.2",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  }
}
